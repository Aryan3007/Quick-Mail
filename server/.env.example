NODE_ENV=development
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API.
# In production set this to your app's deep-link / packaged origin only.
CORS_ORIGINS=http://localhost:5173,app://-

# AI provider selection — change AI_PROVIDER to switch providers.
# Allowed: anthropic | openai | gemini
AI_PROVIDER=anthropic
# Optional override of the default model for the selected provider.
# Defaults: anthropic=claude-sonnet-4-6, openai=gpt-4o-mini, gemini=gemini-2.0-flash
AI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Device-token signing secret (HS256). Generate with: openssl rand -hex 32
# REQUIRED in production. In development a default is used if unset.
DEVICE_TOKEN_SECRET=
# How long a device token is valid before the client must re-register.
DEVICE_TOKEN_TTL_DAYS=90

# Gmail OAuth (Phase 1) — desktop uses PKCE + loopback redirect.
# The desktop app generates an ephemeral redirect_uri like http://127.0.0.1:<port>/cb
# and forwards it to the backend in /v1/auth/google/exchange.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Per-user daily token cap (enforced before forwarding to Anthropic)
DAILY_TOKEN_CAP=1000000
